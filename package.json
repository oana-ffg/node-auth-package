{
  "name": "firefun-node-auth",
  "version": "0.1.0-alpha.18",
  "description": "A secure, production-ready Node.js authentication package with JWT, 2FA, passkeys, and more",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./serverless": {
      "types": "./dist/serverless.d.ts",
      "require": "./dist/serverless.js",
      "import": "./dist/serverless.js"
    }
  },
  "bin": {
    "firefun-auth-setup": "./scripts/setup.js"
  },
  "files": [
    "dist",
    "scripts",
    "prisma",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:exclamation": "ts-node src/test-exclamation-fix.ts",
    "setup": "node scripts/setup.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "nodejs",
    "authentication",
    "jwt",
    "2fa",
    "totp",
    "passkeys",
    "webauthn",
    "prisma",
    "typescript",
    "express",
    "security",
    "rate-limiting",
    "bcrypt",
    "encryption"
  ],
  "author": "FireFun Games <info@firefungames.com>",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/firefun-games/node-auth-package.git"
  },
  "bugs": {
    "url": "https://github.com/firefun-games/node-auth-package/issues"
  },
  "homepage": "https://github.com/firefun-games/node-auth-package#readme",
  "peerDependencies": {
    "@prisma/client": "^6.13.0",
    "express": "^5.0.0"
  },
  "dependencies": {
    "@simplewebauthn/server": "^13.1.2",
    "@simplewebauthn/types": "^12.0.0",
    "bcrypt": "^6.0.0",
    "express-rate-limit": "^8.0.1",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^4.2.1",
    "qrcode": "^1.5.4",
    "speakeasy": "^2.0.0",
    "zod": "^4.0.14"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.1.0",
    "@types/node-cron": "^3.0.11",
    "@types/qrcode": "^1.5.5",
    "@types/speakeasy": "^2.0.10",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
